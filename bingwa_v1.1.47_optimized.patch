++    private fun drainEventRecheck() {
++        eventRecheckPosted = false
++        if (!eventRecheckPending) return
++        eventRecheckPending = false
++        if (!advancedActive &&
++            balanceCallback == null &&
++            tokenPurchaseCallback == null &&
++            !isForegroundUiActive()
