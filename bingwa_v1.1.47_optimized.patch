+private fun formatStartupFallbackErrorLabel(raw: String): String {
+    val cleaned = raw.trim().ifBlank { "Startup issue" }
+    return cleaned
+        .replace('_', ' ')
+        .replace(Regex("([a-z])([A-Z])"), "$1 $2")
+        .replace(Regex("\\s+"), " ")
+        .trim()
+        .take(72)
+}
