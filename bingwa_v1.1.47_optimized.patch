++                        UnlimitedManager(appContext).activate(plan)
++                        TokenManager.tokenBalanceListener?.invoke(TokenManager(appContext).getBalance())
++                        notify(appContext, "Unlimited Activated", "${plan.label} unlimited activated using KSh $amount airtime")
++                    } else {
