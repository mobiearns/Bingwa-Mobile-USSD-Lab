++private fun transactionHistoryTimestamp(tx: Transaction): Long {
++    if (tx.timestamp > 0L) return tx.timestamp
++    return runCatching {
++        SimpleDateFormat("dd/MM/yyyy HH:mm", Locale.getDefault()).parse(tx.date)?.time ?: 0L
++    }.getOrDefault(0L)
++}
