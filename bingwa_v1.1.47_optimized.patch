+private fun requestBalanceCheckSafely(
+    context: Context,
+    selectionOverride: Int? = null,
+    persistResult: Boolean = selectionOverride == null,
+    ignoreCooldown: Boolean = false,
+    specialHandling: Boolean = false
+): Boolean =
