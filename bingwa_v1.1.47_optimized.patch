++private fun maskPhone(phone: String): String {
++    val digits = phone.filter(Char::isDigit)
++    if (digits.length < 7) return phone
++    val prefix = digits.take(min(4, digits.length))
++    val suffix = digits.takeLast(3)
++    return prefix + "***" + suffix
++}
