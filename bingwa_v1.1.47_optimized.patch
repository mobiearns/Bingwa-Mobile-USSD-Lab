+private enum class TransactionHistoryFilter(val label: String) {
+    ALL("All"),
+    COMPLETED("Completed"),
+    PENDING("Pending"),
+    FAILED("Failed"),
+    SCHEDULED("Scheduled"),
+    UNMATCHED("Unmatched")
+}
