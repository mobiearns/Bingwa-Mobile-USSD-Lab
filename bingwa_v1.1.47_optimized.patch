++    fun normalizeUssdCode(raw: String, phoneNumber: String? = null): String {
++        val v = raw.trim()
++            .let {
++                if (phoneNumber != null) {
++                    it.replace("pn", normalizeRecipientForUssdInput(phoneNumber), ignoreCase = true)
++                } else {
++                    it
++                }
++            }
++            .replace("%23", "#")
++        if (v.startsWith("*") && !v.endsWith("#")) return "$v#"
++        return v
++    }
