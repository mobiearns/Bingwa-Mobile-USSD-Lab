+package com.bingwa.mobile
+
+import android.os.Bundle
+import android.util.Log
+import android.view.accessibility.AccessibilityNodeInfo
+
+/**
+ * Writes one response to the input field selected from the currently validated USSD popup.
+ * Submission is permitted only after exact read-back from that same field.
+ */
+internal class UssdNavigationValueWriter(private val service: UssdNavigationService) {
+    companion object {
+        private const val TAG = "UssdNavValueWriter"
+    }
+
+    enum class WriteResult {
+        VERIFIED,
+        ACCEPTED_AWAITING_VERIFY,
+        REJECTED
+    }
+
+    fun writeValueToField(root: AccessibilityNodeInfo, value: String): Boolean {
+        val field = service.findInputField(root) ?: return false
+        return try {
+            writeValueToNode(field, value)
+        } finally {
+            runCatching { field.recycle() }
+        }
+    }
+
+    fun writeValueToNode(field: AccessibilityNodeInfo, value: String): Boolean {
+        return writeValueResult(field, value) == WriteResult.VERIFIED
+    }
+
+    fun writeValueResult(field: AccessibilityNodeInfo, value: String): WriteResult {
+        if (value.isBlank()) return WriteResult.REJECTED
+        val inputStartedAt = UssdPerformanceDiagnostics.mark()
+
+        val initialReadStartedAt = UssdPerformanceDiagnostics.mark()
+        val initialText = runCatching { field.text?.toString() }.getOrNull()
+        UssdPerformanceDiagnostics.record("input.initial_read", initialReadStartedAt, "available=${initialText != null}")
+        if (service.isVerifiedFieldValue(initialText, value)) {
+            service.rememberVerifiedInput(value)
+            service.rememberProgress()
+            UssdPerformanceDiagnostics.record("input.entry", inputStartedAt, "valueLength=${value.length} alreadyPresent=true verified=true")
+            return WriteResult.VERIFIED
+        }
+
+        // A carrier dialer can accept ACTION_SET_TEXT and then clear/recreate its
+        // EditText while moving between prompts. Retry only when the same validated
+        // step's field is observably empty, after a short grace period, and within
+        // a strict attempt limit. Never overwrite a different non-empty response.
+        if (service.hasInputWriteAttemptForCurrentStep(value) &&
+            !service.canRetryInputWriteForCurrentStep(value, initialText)
+        ) {
+            Log.w(TAG, "writeValueToNode: awaiting field refresh or safe retry")
+            return WriteResult.REJECTED
+        }
+
+        val arguments = Bundle().apply {
+            putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, value)
+            putString(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, value)
+        }
+
+        // Try ACTION_SET_TEXT before focusing the EditText. On many dialers, focusing
+        // an inactive field summons the soft keyboard and its opening animation even
+        // though accessibility can set the value directly. Avoid that work on success.
+        // ACTION_SET_TEXT remains the sole text-entry mechanism.
+        val setTextStartedAt = UssdPerformanceDiagnostics.mark()
+        val primarySetTextAccepted = runCatching {
+            field.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, arguments)
+        }.getOrElse {
+            Log.w(TAG, "ACTION_SET_TEXT failed for current popup field", it)
+            false
+        }
+        var accepted = primarySetTextAccepted
+
+        // Compatibility fallback for OEM fields that reject SET_TEXT until focused.
+        // Focus is deliberately deferred until after the focus-free fast attempt fails.
+        val focusFallbackStartedAt = UssdPerformanceDiagnostics.mark()
+        var focusFallbackUsed = false
+        var focusActionAccepted = false
+        if (!accepted) {
+            focusFallbackUsed = true
+            val focusAccepted = runCatching {
+                field.performAction(AccessibilityNodeInfo.ACTION_FOCUS)
+            }.getOrDefault(false)
+            focusActionAccepted = focusAccepted
+            if (!focusAccepted) {
+                runCatching { field.performAction(AccessibilityNodeInfo.ACTION_CLICK) }
+            }
+            accepted = runCatching {
+                field.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, arguments)
+            }.getOrDefault(false)
+        }
+
+        if (focusFallbackUsed) {
+            UssdPerformanceDiagnostics.record(
+                "keyboard.focus_fallback",
+                focusFallbackStartedAt,
+                "focusAccepted=$focusActionAccepted"
+            )
+        }
+
+        UssdPerformanceDiagnostics.record(
+            "input.set_text_action",
+            setTextStartedAt,
+            "primaryAccepted=$primarySetTextAccepted accepted=$accepted focusFallback=$focusFallbackUsed"
+        )
+
+        // Read back even when the OEM reports false: some carrier dialogs apply the
+        // text but return an unreliable action result. Exact field contents are decisive.
+        // Record every ACTION_SET_TEXT attempt, including OEM-reported rejection.
+        service.rememberInputWrite(value)
+
+        val directReadStartedAt = UssdPerformanceDiagnostics.mark()
+        val directText = runCatching { field.text?.toString() }.getOrNull()
+        UssdPerformanceDiagnostics.record(
+            "input.direct_readback",
+            directReadStartedAt,
+            "available=${directText != null}"
+        )
+        if (service.isVerifiedFieldValue(directText, value)) {
+            service.rememberVerifiedInput(value)
+            service.rememberProgress()
+            UssdPerformanceDiagnostics.record("input.entry", inputStartedAt, "valueLength=${value.length} directRead=true verified=true")
+            return WriteResult.VERIFIED
+        }
+
+        // Bounded fast read-back verification:
+        // When ACTION_SET_TEXT is accepted, the dialer's EditText applies text within 1-3ms.
+        // Rather than prematurely deferring to a full-window event cycle (which costs 80-140ms in
+        // root reacquisition and multi-pass snapshot traversals), do up to 3 non-blocking refresh passes.
+        // Each field.refresh() round-trip over Binder takes ~1ms, giving the dialer the sub-frame
+        // interval needed while verifying exact read-back with zero thread sleep.
+        for (pass in 1..3) {
+            val refreshStartedAt = UssdPerformanceDiagnostics.mark()
+            val refreshAccepted = runCatching { field.refresh() }.getOrDefault(false)
+            UssdPerformanceDiagnostics.record("input.node_refresh", refreshStartedAt, "pass=$pass accepted=$refreshAccepted")
+            val refreshedText = runCatching { field.text?.toString() }.getOrNull()
+                ?: service.readFieldTextFast(field)
+            if (service.isVerifiedFieldValue(refreshedText, value)) {
+                service.rememberVerifiedInput(value)
+                service.rememberProgress()
+                UssdPerformanceDiagnostics.record(
+                    "input.entry",
+                    inputStartedAt,
+                    "valueLength=${value.length} pass=$pass refreshedRead=true verified=true"
+                )
+                return WriteResult.VERIFIED
+            }
+        }
+
+        if (accepted) {
+            Log.d(TAG, "ACTION_SET_TEXT accepted; awaiting asynchronous verification via accessibility event")
+            UssdPerformanceDiagnostics.record("input.entry", inputStartedAt, "valueLength=${value.length} accepted=true awaitingVerify=true")
+            return WriteResult.ACCEPTED_AWAITING_VERIFY
+        }
+
+        Log.w(TAG, "ACTION_SET_TEXT rejected and value not present; awaiting bounded safe retry")
+        UssdPerformanceDiagnostics.record("input.entry", inputStartedAt, "valueLength=${value.length} accepted=false verified=false")
+        return WriteResult.REJECTED
+    }
+}
diff --git a/app/src/main/java/com/bingwa/mobile/UssdPerformanceDiagnostics.kt b/app/src/main/java/com/bingwa/mobile/UssdPerformanceDiagnostics.kt
new file mode 100644
index 0000000..59b0ce9
--- /dev/null
+++ b/app/src/main/java/com/bingwa/mobile/UssdPerformanceDiagnostics.kt
@@ -0,0 +1,303 @@
+package com.bingwa.mobile
+
+import android.content.Context
+import android.os.Build
+import android.os.SystemClock
+import android.content.res.Configuration
+import java.util.ArrayDeque
+import java.util.Locale
+
+/**
+ * Low-overhead in-memory USSD performance trace.
+ *
+ * The hot path only records primitive timestamps and short stage labels. It never writes
+ * files, preferences, Logcat, or performs I/O while a USSD popup is being navigated.
+ * The bounded ring buffer is formatted only when the user taps Copy report.
+ */
+internal object UssdPerformanceDiagnostics {
+    private const val MAX_ENTRIES = 500
+
+    private data class Entry(
+        val elapsedMs: Long,
+        val stage: String,
+        val durationMs: Double?,
+        val detail: String
+    )
+
+    private val entries = ArrayDeque<Entry>(MAX_ENTRIES)
+    // Accessibility callbacks can be extremely chatty. Preserve useful USSD evidence
+    // by allowing transaction timings to displace routine callback noise when full.
+    private var suppressedSelfAccessibilityEvents = 0L
+    private var droppedLowPriorityEvents = 0L
+    private var evictedLowerPriorityEvents = 0L
+    private val responseWaitLock = Any()
+    private var pendingResponseStartedAtNanos = 0L
+    private var firstPopupAfterSendRecorded = false
+
+    /** Start carrier/UI response timing only after Android accepts a Send action. */
+    fun markSubmissionAccepted(path: String) {
+        synchronized(responseWaitLock) {
+            pendingResponseStartedAtNanos = SystemClock.elapsedRealtimeNanos()
+            firstPopupAfterSendRecorded = false
+        }
+        record("send.accepted", detail = "path=$path")
+    }
+
+    /**
+     * Separates carrier/dialer waiting from local automation work. The first popup can
+     * be a transient "please wait" screen; usable-response timing ends only when a
+     * non-transient USSD dialog arrives. No menu contents or entered values are stored.
+     */
+    fun markPopupObserved(isTransient: Boolean, characterCount: Int) {
+        val now = SystemClock.elapsedRealtimeNanos()
+        val startedAt: Long
+        val recordFirst: Boolean
+        synchronized(responseWaitLock) {
+            startedAt = pendingResponseStartedAtNanos
+            if (startedAt <= 0L) return
+            recordFirst = !firstPopupAfterSendRecorded
+            if (recordFirst) firstPopupAfterSendRecorded = true
+            if (!isTransient) pendingResponseStartedAtNanos = 0L
+        }
+        val classification = if (isTransient) "transient" else "usable"
+        if (recordFirst) {
+            record(
+                "carrier.first_popup_wait",
+                startedAt,
+                "popup=$classification chars=$characterCount"
+            )
+        }
+        if (!isTransient) {
+            record(
+                "carrier.usable_response_wait",
+                startedAt,
+                "popup=usable chars=$characterCount"
+            )
+        }
+    }
+
+    fun mark(): Long = SystemClock.elapsedRealtimeNanos()
+
+    fun record(stage: String, startedAtNanos: Long? = null, detail: String = "") {
+        val nowNanos = SystemClock.elapsedRealtimeNanos()
+        val duration = startedAtNanos?.let {
+            ((nowNanos - it).coerceAtLeast(0L) / 1_000_000.0)
+        }
+        val safeDetail = detail
+            .replace('\n', ' ')
+            .replace('\r', ' ')
+            .take(100)
+
+        // Bingwa's own accessibility UI events are not USSD evidence and can flood
+        // the trace during foreground transitions.
+        if (stage.startsWith("accessibility.event") && safeDetail.contains("pkg=com.bingwa.mobile")) {
+            synchronized(entries) { suppressedSelfAccessibilityEvents++ }
+            return
+        }
+
+        val entry = Entry(
+            elapsedMs = SystemClock.elapsedRealtime(),
+            stage = stage.take(48),
+            durationMs = duration,
+            detail = safeDetail
+        )
+        synchronized(entries) {
+            if (entries.size >= MAX_ENTRIES) {
+                val incomingPriority = tracePriority(entry.stage)
+                // Prefer evicting routine callback noise over transaction evidence.
+                val lowerPriorityEntry = entries.firstOrNull {
+                    tracePriority(it.stage) < incomingPriority
+                }
+                if (lowerPriorityEntry != null) {
+                    entries.remove(lowerPriorityEntry)
+                    evictedLowerPriorityEvents++
+                } else {
+                    droppedLowPriorityEvents++
+                    return
+                }
+            }
+            entries.addLast(entry)
+        }
+    }
+
+    private fun tracePriority(stage: String): Int = when {
+        stage.startsWith("input.") ||
+            stage.startsWith("send.") ||
+            stage.startsWith("carrier.") ||
+            stage.startsWith("field.") ||
+            stage == "total.local_processing" ||
+            stage == "process.total" ||
+            stage == "step.resolve" -> 3
+
+        stage.startsWith("root.") ||
+            stage.startsWith("snapshot.") ||
+            stage.startsWith("popup.") ||
+            stage.startsWith("event.root_") ||
+            stage.startsWith("event.source_lookup") -> 2
+
+        stage == "accessibility.event" ||
+            stage == "accessibility.event_coalesced" ||
+            stage == "keyboard.window_changed" -> 0
+
+        else -> 1
+    }
+
+    /** Privacy-safe diagnostic stages for USSD signature learning & matching */
+    fun recordLearningInitiated(offerId: Int, stepCount: Int) {
+        record("learning.initiated", detail = "offerId=$offerId steps=$stepCount")
+    }
+
+    fun recordLearningWindowFound(windowPkg: String, windowId: Int, isDialog: Boolean) {
+        record("learning.window_found", detail = "pkg=$windowPkg windowId=$windowId isDialog=$isDialog")
+    }
+
+    fun recordLearningWindowRejected(windowPkg: String, windowId: Int, reason: String) {
+        record("learning.window_rejected", detail = "pkg=$windowPkg windowId=$windowId reason=$reason")
+    }
+
+    fun recordLearningExtractionAttempted(stepIndex: Int, isStringStep: Boolean) {
+        record("learning.extraction_attempted", detail = "step=$stepIndex isString=$isStringStep")
+    }
+
+    fun recordLearningTextExtracted(tokenCount: Int, charCount: Int, hasMenu: Boolean) {
+        record("learning.text_extracted", detail = "tokens=$tokenCount chars=$charCount hasMenu=$hasMenu")
+    }
+
+    fun recordLearningNormalization(stepIndex: Int, rawChars: Int, normalizedChars: Int) {
+        record("learning.text_normalized", detail = "step=$stepIndex rawChars=$rawChars normChars=$normalizedChars")
+    }
+
+    fun recordLearningOptionsIdentified(stepIndex: Int, validOptionsCount: Int, menuTitleFound: Boolean) {
+        record("learning.options_identified", detail = "step=$stepIndex options=$validOptionsCount hasTitle=$menuTitleFound")
+    }
+
+    fun recordLearningSignatureGenerated(stepIndex: Int, optionCount: Int, hasLabel: Boolean) {
+        record("learning.signature_generated", detail = "step=$stepIndex options=$optionCount hasLabel=$hasLabel")
+    }
+
+    fun recordLearningSignatureStored(offerId: Int, stepsCount: Int, capturesCount: Int) {
+        record("learning.signature_stored", detail = "offerId=$offerId steps=$stepsCount captures=$capturesCount")
+    }
+
+    fun recordLearningSignatureRetrieved(offerId: Int, stepsCount: Int) {
+        record("learning.signature_retrieved", detail = "offerId=$offerId steps=$stepsCount")
+    }
+
+    fun recordLearningSignatureMatched(stepIndex: Int, matchedOption: String, autoAdjust: Boolean) {
+        record("learning.signature_matched", detail = "step=$stepIndex matchedOption=$matchedOption autoAdjust=$autoAdjust")
+    }
+
+    fun recordLearningNavigationAction(stepIndex: Int, action: String, targetOption: String) {
+        record("learning.navigation_action", detail = "step=$stepIndex action=$action targetOption=$targetOption")
+    }
+
+    fun getRecordedDetails(): List<String> = synchronized(entries) { entries.map { it.detail } }
+
+    fun buildReport(context: Context): String {
+        val snapshot = synchronized(entries) { entries.toList() }
+        return buildString {
+            appendLine("Bingwa Mobile USSD performance report")
+            val metrics = context.resources.displayMetrics
+            val config = context.resources.configuration
+            val screenType = when {
+                config.smallestScreenWidthDp >= 600 -> "tablet/large-screen"
+                (config.screenLayout and Configuration.SCREENLAYOUT_SIZE_MASK) >= Configuration.SCREENLAYOUT_SIZE_LARGE -> "large-screen"
+                else -> "phone"
+            }
+            val appInfo = runCatching {
+                @Suppress("DEPRECATION")
+                context.packageManager.getPackageInfo(context.packageName, 0)
+            }.getOrNull()
+            val appVersionCode = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                appInfo?.longVersionCode ?: -1L
+            } else {
+                @Suppress("DEPRECATION")
+                (appInfo?.versionCode ?: -1).toLong()
+            }
+            appendLine("DEVICE IDENTITY")
+            appendLine("Manufacturer: ${Build.MANUFACTURER}")
+            appendLine("Brand: ${Build.BRAND}")
+            appendLine("Model: ${Build.MODEL}")
+            appendLine("Device codename: ${Build.DEVICE}")
+            appendLine("Product: ${Build.PRODUCT}")
+            appendLine("Board: ${Build.BOARD}")
+            appendLine("Hardware: ${Build.HARDWARE}")
+            appendLine("Device type: $screenType")
+            appendLine("Screen: ${metrics.widthPixels}x${metrics.heightPixels} px, ${metrics.densityDpi} dpi, density=${String.format(Locale.US, "%.2f", metrics.density)}")
+            appendLine("Supported ABIs: ${Build.SUPPORTED_ABIS.joinToString(", ")}")
+            appendLine()
+            appendLine("ANDROID / OEM SOFTWARE")
+            appendLine("Android version: ${Build.VERSION.RELEASE}")
+            appendLine("Android SDK: ${Build.VERSION.SDK_INT}")
+            appendLine("Android codename: ${Build.VERSION.CODENAME}")
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                appendLine("Security patch: ${Build.VERSION.SECURITY_PATCH}")
+                appendLine("Base OS: ${Build.VERSION.BASE_OS.ifBlank { "not reported" }}")
+            }
+            appendLine("OEM build/display (may identify XOS/HiOS/One UI version): ${Build.DISPLAY}")
+            appendLine("Build incremental: ${Build.VERSION.INCREMENTAL}")
+            appendLine("Build fingerprint: ${Build.FINGERPRINT}")
+            appendLine()
+            appendLine("APP")
+            appendLine("App package: ${context.packageName}")
+            appendLine("App version: ${appInfo?.versionName ?: "unknown"} (code $appVersionCode)")
+            appendLine("Capture: in-memory priority-preserving ring buffer; ${snapshot.size}/$MAX_ENTRIES events retained")
+            val bufferStats = synchronized(entries) {
+                Triple(suppressedSelfAccessibilityEvents, droppedLowPriorityEvents, evictedLowerPriorityEvents)
+            }
+            appendLine("Diagnostics buffer: self-generated accessibility events suppressed=${bufferStats.first}, low-priority events dropped=${bufferStats.second}, lower-priority events displaced=${bufferStats.third}")
+            appendLine("Privacy: no serial number, IMEI, phone numbers, PINs, USSD menu text or entered values are recorded.")
+            appendLine()
+            appendLine("ADAPTIVE SEND LEARNING")
+            appendLine(UssdAdaptiveSendMemory(context).buildReportSummary())
+            appendLine()
+            appendLine("STAGE MEASUREMENTS")
+            appendLine("Stage | Average | Maximum")
+            val stageAliases = listOf(
+                "Snapshot traversal" to setOf("snapshot.traversal"),
+                "Popup snapshot capture" to setOf("popup.snapshot_capture"),
+                "Root acquisition" to setOf("event.root_acquire", "root.window_root_retrieval", "root.source_lookup"),
+                "Field discovery" to setOf("field.discovery", "field.tree_scan", "field.focused_lookup", "field.common_id_lookup"),
+                "Input" to setOf("input.entry"),
+                "Send acceptance" to setOf("send.accepted", "send.method_accepted"),
+                "Total processing" to setOf("total.local_processing"),
+                "Carrier usable response wait" to setOf("carrier.usable_response_wait")
+            )
+            stageAliases.forEach { (label, stageKeys) ->
+                val matching = snapshot.filter { it.durationMs != null && it.stage in stageKeys }
+                if (matching.isNotEmpty()) {
+                    val values = matching.mapNotNull { it.durationMs }
+                    val avg = values.average()
+                    val max = values.maxOrNull() ?: 0.0
+                    appendLine(String.format(Locale.US, "%-28s| %8.2f ms| %8.2f ms", label, avg, max))
+                }
+            }
+            appendLine()
+            appendLine("STAGE SUMMARY (milliseconds)")
+            appendLine("Timing note: stages can overlap; accessibility.event includes work performed inside its callback. Do not add stage averages together.")
+            val timed = snapshot.filter { it.durationMs != null }.groupBy { it.stage }
+            if (timed.isEmpty()) appendLine("No timed events captured yet.")
+            timed.forEach { (stage, items) ->
+                val values = items.mapNotNull { it.durationMs }.sorted()
+                val average = values.average()
+                val p95 = values[(kotlin.math.ceil(values.size * 0.95).toInt() - 1).coerceIn(0, values.lastIndex)]
+                appendLine(
+                    String.format(
+                        Locale.US,
+                        "%s count=%d avg=%.2f p95=%.2f max=%.2f",
+                        stage, values.size, average, p95, values.last()
+                    )
+                )
+            }
+            appendLine()
+            appendLine("EVENT TRACE (elapsed ms | stage | duration ms | detail)")
+            snapshot.forEach { entry ->
+                val duration = entry.durationMs?.let { String.format(Locale.US, "%.2f", it) } ?: "-"
+                appendLine("${entry.elapsedMs} | ${entry.stage} | $duration | ${entry.detail}")
+            }
+            if (snapshot.isEmpty()) {
+                appendLine("No USSD performance events captured. Run one automated USSD session, then copy this report.")
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/com/bingwa/mobile/UssdQueue.kt b/app/src/main/java/com/bingwa/mobile/UssdQueue.kt
new file mode 100644
index 0000000..323421e
--- /dev/null
+++ b/app/src/main/java/com/bingwa/mobile/UssdQueue.kt
@@ -0,0 +1,292 @@
+package com.bingwa.mobile
+
+import android.content.Context
+import android.os.Handler
+import android.os.HandlerThread
+import android.os.Looper
+import android.util.Log
+import java.util.concurrent.PriorityBlockingQueue
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * A thread‑safe, priority‑aware task queue for USSD operations.
+ * Tasks are executed sequentially on a dedicated background thread.
+ * Supports:
+ * - 3 priority levels (SPECIAL, HIGH, NORMAL)
+ * - Task timeout (automatically aborts stuck tasks)
+ * - Cancellation (by task ID or all pending)
+ * - Detailed logging for debugging
+ * - Automatic retry of failed tasks (optional, disabled by default)
+ */
+object UssdQueue {
+    private const val TAG = "UssdQueue"
+
+    // Priority levels (higher number = higher priority)
+    private const val PRIORITY_SPECIAL = 2
+    private const val PRIORITY_HIGH = 1
+    private const val PRIORITY_NORMAL = 0
+
+    // Task timeout in milliseconds (if a task runs longer, it will be aborted)
+    // Reduced from 30s to 15s to avoid long stalls when USSD popups are slow
+    private const val TASK_TIMEOUT_MS = 15_000L
+
+    // Retry policy (0 = no retry by default, can be overridden per task)
+    private const val DEFAULT_MAX_RETRIES = 1
+
+    // Dedicated worker thread
+    private val workerThread = HandlerThread("UssdQueueWorker").apply { start() }
+    private val workerHandler = Handler(workerThread.looper)
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    // Priority queue (FIFO within same priority)
+    private val taskSequence = AtomicLong(0L)
+    private val taskQueue = PriorityBlockingQueue<QueueTask>(11, compareByDescending<QueueTask> { it.priority }.thenBy { it.sequence })
+
+    // Flag to signal worker loop to stop
+    private val stopWorker = AtomicBoolean(false)
+
+    // Current running task (for cancellation/timeout)
+    private var currentTask: QueueTask? = null
+    private var currentTimeoutRunnable: Runnable? = null
+
+    // Lock for synchronizing state changes
+    private val lock = Any()
+
+    init {
+        // Start the worker loop
+        workerHandler.post { workerLoop() }
+    }
+
+    /**
+     * Enqueues a task with the given priority.
+     * @param task the action to run
+     * @param priority one of [USSD_EXECUTION_PRIORITY_SPECIAL], [USSD_EXECUTION_PRIORITY_HIGH], or [USSD_EXECUTION_PRIORITY_NORMAL]
+     * @param maxRetries maximum number of retries on failure (default 1)
+     * @return a token that can be used to cancel the task (or null if not needed)
+     */
+    fun enqueue(task: Runnable, priority: String = USSD_EXECUTION_PRIORITY_NORMAL, maxRetries: Int = DEFAULT_MAX_RETRIES): CancellationToken? {
+        val p = when {
+            priority.equals(USSD_EXECUTION_PRIORITY_SPECIAL, ignoreCase = true) -> PRIORITY_SPECIAL
+            priority.equals(USSD_EXECUTION_PRIORITY_HIGH, ignoreCase = true) -> PRIORITY_HIGH
+            else -> PRIORITY_NORMAL
+        }
+        val queueTask = QueueTask(task, p, maxRetries, taskSequence.incrementAndGet())
+        taskQueue.add(queueTask)
+        Log.d(TAG, "Enqueued task with priority $p, maxRetries=$maxRetries, queue size=${taskQueue.size}")
+        return queueTask.token
+    }
+
+    /**
+     * Enqueues a balance check as a special priority task.
+     */
+    fun enqueueBalanceCheck(context: Context) {
+        enqueue(
+            task = Runnable {
+                BalanceChecker.requestBalanceCheck(context, specialHandling = true)
+            },
+            priority = USSD_EXECUTION_PRIORITY_SPECIAL,
+            maxRetries = 2
+        )
+    }
+
+    /**
+     * Cancels a specific task using its cancellation token.
+     * @return true if the task was removed from the queue (or is the currently running task and was aborted)
+     */
+    fun cancel(token: CancellationToken): Boolean {
+        synchronized(lock) {
+            // Check if it's the currently running task
+            val current = currentTask
+            if (current?.token === token) {
+                // Abort the running task (handled in workerLoop)
+                Log.w(TAG, "Cancelling currently running task")
+                current.abortRequested = true
+                return true
+            }
+            // Remove from queue
+            val removed = taskQueue.removeIf { it.token === token }
+            if (removed) {
+                Log.d(TAG, "Cancelled pending task (removed from queue)")
+            }
+            return removed
+        }
+    }
+
+    /**
+     * Cancels all pending tasks (does not affect the currently running one).
+     * @return number of tasks removed
+     */
+    fun cancelAllPending(): Int {
+        synchronized(lock) {
+            val count = taskQueue.size
+            taskQueue.clear()
+            Log.d(TAG, "Cancelled $count pending tasks")
+            return count
+        }
+    }
+
+    /**
+     * Checks if there is any work pending or currently running.
+     */
+    fun hasWork(): Boolean {
+        synchronized(lock) {
+            return currentTask != null || taskQueue.isNotEmpty()
+        }
+    }
+
+    /**
+     * Returns the number of tasks currently in the queue.
+     */
+    fun pendingCount(): Int {
+        synchronized(lock) {
+            return taskQueue.size
+        }
+    }
+
+    /**
+     * Shuts down the worker thread gracefully.
+     * Pending tasks will not be executed.
+     */
+    fun shutdown() {
+        stopWorker.set(true)
+        workerThread.quitSafely()
+        Log.i(TAG, "Shutdown complete")
+    }
+
+    // ------------------ Worker Loop ------------------
+
+    private fun workerLoop() {
+        while (!stopWorker.get()) {
+            try {
+                // Poll the queue with a timeout so we can check stop flag periodically
+                val task = taskQueue.poll(200, TimeUnit.MILLISECONDS) ?: continue
+
+                // Set as current task
+                synchronized(lock) {
+                    currentTask = task
+                }
+
+                // Execute with timeout and error handling
+                executeTask(task)
+
+                // Clear current task
+                synchronized(lock) {
+                    currentTask = null
+                    currentTimeoutRunnable?.let { mainHandler.removeCallbacks(it) }
+                    currentTimeoutRunnable = null
+                }
+            } catch (e: InterruptedException) {
+                // Thread interrupted, probably shutting down
+                Thread.currentThread().interrupt()
+                break
+            } catch (e: Exception) {
+                Log.e(TAG, "Unexpected error in worker loop", e)
+            }
+        }
+    }
+
+    private fun executeTask(task: QueueTask) {
+        var retries = 0
+        var success = false
+        while (retries <= task.maxRetries && !task.abortRequested && !stopWorker.get()) {
+            try {
+                if (!waitForSilentUssdLock()) {
+                    throw IllegalStateException("Another USSD engine is still active; refusing overlapping request")
+                }
+
+                val timeoutRunnable = Runnable {
+                    synchronized(lock) {
+                        if (currentTask === task) {
+                            Log.e(TAG, "Task timed out after ${TASK_TIMEOUT_MS}ms")
+                            task.abortRequested = true
+                        }
+                    }
+                }
+                synchronized(lock) {
+                    currentTimeoutRunnable = timeoutRunnable
+                }
+                mainHandler.postDelayed(timeoutRunnable, TASK_TIMEOUT_MS)
+
+                task.runnable.run()
+                success = true
+
+                mainHandler.removeCallbacks(timeoutRunnable)
+                synchronized(lock) {
+                    if (currentTimeoutRunnable === timeoutRunnable) {
+                        currentTimeoutRunnable = null
+                    }
+                }
+
+                if (task.abortRequested) {
+                    Log.w(TAG, "Task was aborted (timeout or cancellation)")
+                    success = false
+                }
+                break
+            } catch (e: Exception) {
+                Log.e(TAG, "Task execution failed (attempt ${retries + 1}/${task.maxRetries})", e)
+                retries++
+                if (retries > task.maxRetries) {
+                    success = false
+                    break
+                }
+                val backoffMs = (RETRY_BASE_DELAY_MS * (1L shl (retries - 1))).coerceAtMost(MAX_RETRY_BACKOFF_MS)
+                Log.d(TAG, "Retrying task in ${backoffMs}ms (attempt $retries/${task.maxRetries})")
+                Thread.sleep(backoffMs)
+            }
+        }
+
+        if (!success && !task.abortRequested && !stopWorker.get()) {
+            Log.w(TAG, "Task failed after ${task.maxRetries} retries")
+        }
+    }
+
+    private fun waitForSilentUssdLock(): Boolean {
+        val waitStart = System.currentTimeMillis()
+        val maxWait = 3_000L
+        while ((SilentUssdOptimized.isExecutionInProgress() || SilentUssd.isExecutionInProgress()) &&
+            System.currentTimeMillis() - waitStart < maxWait
+        ) {
+            try {
+                Thread.sleep(50)
+            } catch (_: InterruptedException) {
+                Thread.currentThread().interrupt()
+                return false
+            }
+        }
+        if (SilentUssdOptimized.isExecutionInProgress() || SilentUssd.isExecutionInProgress()) {
+            Log.w(TAG, "Silent USSD engine still busy after waiting ${maxWait}ms; task will be retried instead of overlapping")
+            return false
+        }
+        return true
+    }
+
+    // ------------------ Internal Classes ------------------
+
+    private class QueueTask(
+        val runnable: Runnable,
+        val priority: Int,
+        val maxRetries: Int,
+        val sequence: Long
+    ) {
+        val token = CancellationToken()
+        @Volatile var abortRequested = false
+    }
+
+    /**
+     * Opaque token used to cancel a previously enqueued task.
+     */
+    class CancellationToken internal constructor()
+
+    // We need to keep the public constants for priority strings
+    // These are typically defined elsewhere; we'll reference them or redeclare.
+    // If they don't exist, we can define them here.
+    const val USSD_EXECUTION_PRIORITY_SPECIAL = "SPECIAL"
+    const val USSD_EXECUTION_PRIORITY_HIGH = "HIGH"
+    const val USSD_EXECUTION_PRIORITY_NORMAL = "NORMAL"
+
+    // Retry constants
+    private const val RETRY_BASE_DELAY_MS = 500L
+    private const val MAX_RETRY_BACKOFF_MS = 5_000L
+}
diff --git a/app/src/main/java/com/bingwa/mobile/UssdResponsePatternManager.kt b/app/src/main/java/com/bingwa/mobile/UssdResponsePatternManager.kt
