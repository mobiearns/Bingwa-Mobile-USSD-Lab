++    }
++    val exactAlarmReady = AlarmCompat.canScheduleExactAlarms(context)
++    val simCount = getAvailableSims(context).size
++    val manufacturer = Build.MANUFACTURER.replaceFirstChar { it.uppercase() }
++    val passedChecks = listOf(
