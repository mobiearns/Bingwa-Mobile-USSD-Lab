@@ -0,0 +1,78 @@
+package com.bingwa.mobile
+
+import android.content.Context
+import android.os.Build
+import java.util.Locale
+
+/**
+ * Lightweight per-device, per-popup Send-method learning.
+ * Only confirmed prompt transitions are samples; carrier wait is excluded.
+ */
+internal class UssdAdaptiveSendMemory(context: Context) {
+    private val preferences = context.applicationContext.getSharedPreferences(
+        "ussd_adaptive_send_memory",
+        Context.MODE_PRIVATE
+    )
+    private val devicePrefix = buildString {
+        append("device.")
+        append(Build.MANUFACTURER.lowercase(Locale.ROOT).replace(Regex("[^a-z0-9]+"), "_"))
+        append(".")
+        append(Build.MODEL.lowercase(Locale.ROOT).replace(Regex("[^a-z0-9]+"), "_"))
+        append(".sdk")
+        append(Build.VERSION.SDK_INT)
+        append(".")
+    }
+
+    @Synchronized
+    fun preferredMethod(popupSignature: String): String {
+        val prefix = layoutPrefix(popupSignature)
+        val ranked = METHODS.mapNotNull { method ->
+            val count = preferences.getLong(key(prefix, method, "count"), 0L)
+            if (count <= 0L) return@mapNotNull null
+            method to preferences.getLong(key(prefix, method, "avg_us"), Long.MAX_VALUE)
+        }
+        // New popup signatures start with IME; known layouts use their own learned winner.
+        return ranked.minByOrNull { it.second }?.first ?: METHOD_IME
+    }
+
+    @Synchronized
+    fun recordConfirmed(method: String, localDurationUs: Long, popupSignature: String) {
+        if (method !in METHODS) return
+        val sample = localDurationUs.coerceAtLeast(0L)
+        updateAverage(devicePrefix, method, sample)
+        updateAverage(layoutPrefix(popupSignature), method, sample)
+    }
+
+    private fun updateAverage(prefix: String, method: String, sampleUs: Long) {
+        val countKey = key(prefix, method, "count")
+        val averageKey = key(prefix, method, "avg_us")
+        val count = preferences.getLong(countKey, 0L)
+        val previous = preferences.getLong(averageKey, sampleUs)
+        // Exponential moving average adapts when keyboard or popup behaviour changes.
+        val updated = if (count == 0L) sampleUs else (previous * 3L + sampleUs) / 4L
+        preferences.edit()
+            .putLong(countKey, count + 1L)
+            .putLong(averageKey, updated)
+            .apply()
+    }
+
+    fun buildReportSummary(): String = buildString {
+        appendLine("Cold-start default: $METHOD_IME")
+        METHODS.forEach { method ->
+            val count = preferences.getLong(key(devicePrefix, method, "count"), 0L)
+            val average = preferences.getLong(key(devicePrefix, method, "avg_us"), 0L)
+            appendLine("$method confirmed=$count average_local_action_us=$average")
+        }
+        append("Only confirmed prompt transitions count; carrier/network wait is excluded.")
+    }
+
+    private fun layoutPrefix(signature: String): String =
+        devicePrefix + "layout." + Integer.toHexString(signature.hashCode()) + "."
+
+    private fun key(prefix: String, method: String, metric: String): String = "$prefix$method.$metric"
+
+    private companion object {
+        const val METHOD_IME = "ime"
+        val METHODS = setOf("ime", "resource_id", "tree_scan")
+    }
+}
diff --git a/app/src/main/java/com/bingwa/mobile/UssdHelper.kt b/app/src/main/java/com/bingwa/mobile/UssdHelper.kt
new file mode 100644
index 0000000..8225be4
--- /dev/null
+++ b/app/src/main/java/com/bingwa/mobile/UssdHelper.kt
@@ -0,0 +1,475 @@
+package com.bingwa.mobile
+
+import android.Manifest
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.telecom.TelecomManager
+import android.telephony.SubscriptionManager
+import android.telephony.TelephonyManager
+import android.util.Log
+import androidx.core.content.ContextCompat
+
+object UssdHelper {
+    // Some OEM dialers keep reclaiming focus for a short time after the initial call launch.
+    // A few later retries help restore the app UI on slower or customized Android builds.
+    private val RETURN_TO_APP_DELAYS_MS = longArrayOf(0L, 80L, 200L, 450L, 800L, 1_400L)
+
+    fun normalizeRecipientForUssdInput(phone: String): String {
+        val digits = phone.trim().replace("+", "").replace(Regex("\\D+"), "")
+        if (digits.isBlank()) return ""
+
+        val local = SmsCommandHandler.normalizePhone(phone).replace(Regex("\\D+"), "")
+        return when {
+            local.length == 10 && local.startsWith("0") -> local
+            local.length == 9 && (local.startsWith("7") || local.startsWith("1")) -> "0$local"
+            digits.length == 12 && digits.startsWith("254") -> "0${digits.drop(3)}"
+            digits.length == 9 && (digits.startsWith("7") || digits.startsWith("1")) -> "0$digits"
+            digits.length == 10 && digits.startsWith("0") -> digits
+            else -> digits
+        }
+    }
+
+    fun normalizeUssdCode(raw: String, phoneNumber: String? = null): String {
+        val v = raw.trim()
+            .let {
+                if (phoneNumber != null) {
+                    it.replace("pn", normalizeRecipientForUssdInput(phoneNumber), ignoreCase = true)
+                } else {
+                    it
+                }
+            }
+            .replace("%23", "#")
+        if (v.startsWith("*") && !v.endsWith("#")) return "$v#"
+        return v
+    }
+
+    /**
+     * Validates a USSD code before attempting to dial.
+     * Returns null if valid, or an error message if invalid.
+     */
+    fun validateUssdCode(code: String): String? {
+        val trimmed = code.trim()
+        if (trimmed.isBlank()) return "USSD code is empty"
+        if (!trimmed.startsWith("*")) return "USSD code must start with '*'"
+        if (!trimmed.endsWith("#")) return "USSD code must end with '#'"
+        if (trimmed.length < 3) return "USSD code too short (minimum *#)"
+        if (trimmed.length > 50) return "USSD code too long (maximum 50 chars)"
+        // Check for valid characters: digits, *, #, and optional pn placeholder
+        val validPattern = Regex("^[*#\\d]+$")
+        if (!validPattern.containsMatchIn(trimmed.replace("pn", "", ignoreCase = true))) {
+            return "USSD code contains invalid characters (only digits, *, #, 'pn' allowed)"
+        }
+        // Ensure at least one digit between * and #
+        val inner = trimmed.substring(1, trimmed.length - 1)
+        if (!Regex("\\d").containsMatchIn(inner)) {
+            return "USSD code must contain at least one digit"
+        }
+        // Warn on suspicious patterns
+        if (inner.count { it == '*' } > 2) {
+            Log.w("UssdHelper", "USSD code has multiple '*' separators: $code")
+        }
+        return null
+    }
+
+    fun dialUssd(
+        context: Context,
+        ussdCode: String,
+        silentOnly: Boolean = false,
+        subIdOverride: Int? = null,
+        onSuccess: ((String) -> Unit)? = null,
+        onFailure: ((String) -> Unit)? = null
+    ): Boolean {
+        val validationError = validateUssdCode(ussdCode)
+        if (validationError != null) {
+            Log.e("UssdHelper", "USSD validation failed: $validationError")
+            onFailure?.invoke(validationError)
+            return false
+        }
+        val code = normalizeUssdCode(ussdCode)
+        Log.d("UssdHelper", "Dialing: $code")
+        val targets = resolveUssdSimTargets(context, selectionOverride = subIdOverride)
+        if (targets.isEmpty()) {
+            onFailure?.invoke("Selected SIM slot is unavailable")
+            return false
+        }
+        return dialUssdAttempt(
+            context = context,
+            code = code,
+            silentOnly = silentOnly,
+            targets = targets,
+            attemptIndex = 0,
+            onSuccess = onSuccess,
+            onFailure = onFailure
+        )
+    }
+
+    fun dialUssd(context: Context, ussdCode: String) {
+        dialUssd(context, ussdCode, silentOnly = false, subIdOverride = null, onSuccess = null, onFailure = null)
+    }
+
+    private fun dialUssdAttempt(
+        context: Context,
+        code: String,
+        silentOnly: Boolean,
+        targets: List<UssdSimTarget>,
+        attemptIndex: Int,
+        onSuccess: ((String) -> Unit)?,
+        onFailure: ((String) -> Unit)?
+    ): Boolean {
+        val target = targets.getOrNull(attemptIndex)
+        if (target == null) {
+            onFailure?.invoke("Selected SIM slot is unavailable")
+            return false
+        }
+        val tm = selectedTelephonyManager(context, target?.subId)
+        if (tm == null) {
+            val reason = "Telephony unavailable on this phone"
+            return if (attemptIndex + 1 < targets.size) {
+                dialUssdAttempt(context, code, silentOnly, targets, attemptIndex + 1, onSuccess, onFailure)
+            } else {
+                if (!silentOnly) {
+                    fallbackToVisible(context, code, onSuccess, onFailure, target?.subId)
+                } else {
+                    onFailure?.invoke(reason)
+                    false
+                }
+            }
+        }
+
+        val slotLabel = target?.slotIndex?.let { "slot ${it + 1}" } ?: "default telephony"
+        Log.d("UssdHelper", "Trying USSD on $slotLabel")
+
+        val silentOk = SilentUssdOptimized.execute(
+            tm,
+            code,
+            onSuccess = { onSuccess?.invoke(it) },
+            onFailure = { error ->
+                val nextTarget = targets.getOrNull(attemptIndex + 1)
+                if (nextTarget != null) {
+                    Log.w(
+                        "UssdHelper",
+                        "USSD failed on $slotLabel, retrying slot ${nextTarget.slotIndex + 1}: $error"
+                    )
+                    dialUssdAttempt(context, code, silentOnly, targets, attemptIndex + 1, onSuccess, onFailure)
+                } else if (!silentOnly) {
+                    fallbackToVisible(context, code, onSuccess, onFailure, target?.subId)
+                } else {
+                    onFailure?.invoke(error)
+                }
+            }
+        )
+        if (silentOk) return true
+
+        val legacySilentOk = SilentUssd.execute(
+            tm,
+            code,
+            onSuccess = { onSuccess?.invoke(it) },
+            onFailure = { error ->
+                val nextTarget = targets.getOrNull(attemptIndex + 1)
+                if (nextTarget != null) {
+                    Log.w(
+                        "UssdHelper",
+                        "Legacy silent USSD failed on $slotLabel, retrying slot ${nextTarget.slotIndex + 1}: $error"
+                    )
+                    dialUssdAttempt(context, code, silentOnly, targets, attemptIndex + 1, onSuccess, onFailure)
+                } else if (!silentOnly) {
+                    fallbackToVisible(context, code, onSuccess, onFailure, target?.subId)
+                } else {
+                    onFailure?.invoke(error)
+                }
+            }
+        )
+        if (legacySilentOk) return true
+
+        return if (attemptIndex + 1 < targets.size) {
+            val nextTarget = targets[attemptIndex + 1]
+            Log.w(
+                "UssdHelper",
+                "Silent USSD could not start on $slotLabel, retrying slot ${nextTarget.slotIndex + 1}"
+            )
+            dialUssdAttempt(context, code, silentOnly, targets, attemptIndex + 1, onSuccess, onFailure)
+        } else {
+            if (!silentOnly) {
+                fallbackToVisible(context, code, onSuccess, onFailure, target?.subId)
+            } else {
+                onFailure?.invoke("Silent unsupported")
+                false
+            }
+        }
+    }
+
+    private fun fallbackToVisible(
+        context: Context,
+        code: String,
+        onSuccess: ((String) -> Unit)?,
+        onFailure: ((String) -> Unit)?,
+        subIdOverride: Int? = null
+    ): Boolean {
+        try {
+            val intent = buildCallIntent(context, code, subIdOverride)
+            if (intent.resolveActivity(context.packageManager) != null) {
+                val keepAppUiVisible = BingwaMobileApp.wasInForegroundRecently()
+                if (keepAppUiVisible) UssdNavigationService.armForegroundUi()
+                context.startActivity(intent)
+                if (keepAppUiVisible) relaunchAppUi(context)
+                return false
+            }
+            else { onFailure?.invoke("No dialer"); return false }
+        } catch (e: SecurityException) {
+            OfferNotifications.notify(context, "Permission required", "Open Bingwa Mobile and allow call permission to continue USSD.")
+            onFailure?.invoke(e.message ?: "SecurityException")
+            return false
+        } catch (e: Exception) {
+            OfferNotifications.notify(context, "Open app to continue", "Tap to complete USSD request.")
+            onFailure?.invoke(e.message ?: "Error")
+            return false
+        }
+    }
+
+    fun canPlaceCalls(context: Context): Boolean =
+        ContextCompat.checkSelfPermission(context, Manifest.permission.CALL_PHONE) ==
+            PackageManager.PERMISSION_GRANTED
+
+    fun findPhoneAccountHandleForSubscription(
+        context: Context,
+        subId: Int,
+        targetSlot: Int?
+    ): android.telecom.PhoneAccountHandle? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.M) return null
+        val telecom = context.getSystemService(Context.TELECOM_SERVICE) as? TelecomManager ?: return null
+        val sm = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP_MR1) {
+            context.getSystemService(Context.TELEPHONY_SUBSCRIPTION_SERVICE) as? SubscriptionManager
+        } else null
+        val simInfo = runCatching { sm?.getActiveSubscriptionInfo(subId) }.getOrNull()
+        val iccid = simInfo?.iccId?.trim().orEmpty()
+        val slot = targetSlot ?: simInfo?.simSlotIndex
+
+        val accounts = runCatching { telecom.callCapablePhoneAccounts }.getOrNull() ?: emptyList()
+        if (accounts.isEmpty()) return null
+
+        // 1. Exact match on subscription ID in account extras
+        for (handle in accounts) {
+            val account = runCatching { telecom.getPhoneAccount(handle) }.getOrNull()
+            val extras = account?.extras
+            if (extras != null) {
+                val extraSubId = extras.getInt("android.telephony.extra.SUBSCRIPTION_ID", -1)
+                    .takeIf { it != -1 }
+                    ?: extras.getInt("subscription_id", -1)
+                    .takeIf { it != -1 }
+                    ?: extras.getString("android.telephony.extra.SUBSCRIPTION_ID")?.toIntOrNull()
+                    ?: extras.getString("subscription_id")?.toIntOrNull()
+                if (extraSubId == subId) {
+                    Log.d("UssdHelper", "Matched PhoneAccountHandle by extra subId=$subId: $handle")
+                    return handle
+                }
+            }
+        }
+
+        // 2. Exact match on slot index in account extras
+        if (slot != null && slot >= 0) {
+            for (handle in accounts) {
+                val account = runCatching { telecom.getPhoneAccount(handle) }.getOrNull()
+                val extras = account?.extras
+                if (extras != null) {
+                    val extraSlot = extras.getInt("android.telephony.extra.SLOT_INDEX", -1)
+                        .takeIf { it != -1 }
+                        ?: extras.getInt("slot_index", -1)
+                        .takeIf { it != -1 }
+                        ?: extras.getString("android.telephony.extra.SLOT_INDEX")?.toIntOrNull()
+                        ?: extras.getString("slot_index")?.toIntOrNull()
+                    if (extraSlot == slot) {
+                        Log.d("UssdHelper", "Matched PhoneAccountHandle by extra slot=$slot: $handle")
+                        return handle
+                    }
+                }
+            }
+        }
+
+        // 3. Exact match on handle.id == subId.toString()
+        val subIdStr = subId.toString()
+        for (handle in accounts) {
+            if (handle.id == subIdStr) {
+                Log.d("UssdHelper", "Matched PhoneAccountHandle by exact subId string: $handle")
+                return handle
+            }
+        }
+
+        // 4. Exact match or prefix match on ICCID (SIM card serial number)
+        if (iccid.isNotBlank()) {
+            for (handle in accounts) {
+                if (handle.id == iccid || handle.id.startsWith(iccid) || iccid.startsWith(handle.id)) {
+                    Log.d("UssdHelper", "Matched PhoneAccountHandle by iccid: $handle")
+                    return handle
+                }
+            }
+        }
+
+        // 5. Match by slot index pattern (MediaTek / Transsion / Samsung: "0" or "1", ending with ":0", "_0", etc.)
+        if (slot != null && slot >= 0) {
+            val slotStr = slot.toString()
+            for (handle in accounts) {
+                val id = handle.id
+                if (id == slotStr ||
+                    id.endsWith(":$slot") ||
+                    id.endsWith("_$slot") ||
+                    id.endsWith("/$slot") ||
+                    id.equals("sim$slot", ignoreCase = true) ||
+                    id.equals("slot$slot", ignoreCase = true) ||
+                    id.equals("slot_${slot + 1}", ignoreCase = true)
+                ) {
+                    Log.d("UssdHelper", "Matched PhoneAccountHandle by slot pattern slot=$slot: $handle")
+                    return handle
+                }
+            }
+
+            // 6. Positional match if accounts count matches available active SIMs
+            if (slot in accounts.indices) {
+                val candidate = accounts[slot]
+                Log.d("UssdHelper", "Mapping PhoneAccountHandle by positional slot=$slot: $candidate")
+                return candidate
+            }
+        }
+
+        // Avoid returning an arbitrary SIM 1 handle when SIM 2 was requested
+        Log.w("UssdHelper", "No confirmed PhoneAccountHandle found for subId=$subId slot=$slot; letting intent extras route SIM")
+        return null
+    }
+
+    fun buildCallIntent(
+        context: Context,
+        ussdCode: String,
+        subIdOverride: Int? = null,
+        slotOverride: Int? = null
+    ): Intent {
+        val code = normalizeUssdCode(ussdCode)
+        val uri = Uri.parse("tel:" + Uri.encode(code))
+        val canCall = canPlaceCalls(context)
+        val action = if (canCall) Intent.ACTION_CALL else Intent.ACTION_DIAL
+        val intent = Intent(action).apply { data = uri; addFlags(Intent.FLAG_ACTIVITY_NEW_TASK) }
+        val subId = subIdOverride ?: resolvePreferredUssdSubId(context) ?: -1
+        if (subId != -1) {
+            val slot = slotOverride ?: runCatching {
+                if (Build.VERSION.SDK_INT < Build.VERSION_CODES.LOLLIPOP_MR1) {
+                    null
+                } else {
+                    val sm = context.getSystemService(Context.TELEPHONY_SUBSCRIPTION_SERVICE) as? SubscriptionManager
+                    sm?.getActiveSubscriptionInfo(subId)?.simSlotIndex
+                }
+            }.getOrNull()
+
+            // Standard Android subscription extras
+            intent.putExtra("android.telephony.extra.SUBSCRIPTION_ID", subId)
+            intent.putExtra("subscription", subId)
+            intent.putExtra("subscription_id", subId)
+            intent.putExtra("sub_id", subId)
+            intent.putExtra("subId", subId)
+            intent.putExtra("sim_id", subId.toLong())
+            intent.putExtra("org.codeaurora.extra.SUB_ID", subId)
+            intent.putExtra("phone.subscription", subId)
+
+            // Slot-specific extras covering Android, MediaTek, Transsion (Infinix Hot 30i / Tecno / itel), Qualcomm, Samsung
+            if (slot != null && slot >= 0) {
+                // Android standard
+                intent.putExtra("android.telephony.extra.SLOT_INDEX", slot)
+                intent.putExtra("com.android.phone.force.slot", slot)
+                intent.putExtra("com.android.phone.extra.slot", slot)
+                intent.putExtra("slot", slot)
+                intent.putExtra("simSlot", slot)
+                intent.putExtra("slot_id", slot)
+                intent.putExtra("sim_index", slot)
+                intent.putExtra("phone_id", slot)
+
+                // MediaTek dual SIM extras
+                intent.putExtra("com.mediatek.telephony.slot", slot)
+                intent.putExtra("simId", slot)
+                intent.putExtra("simnum", slot + 1)
+                intent.putExtra("sim_slot", slot)
+
+                // Transsion (Infinix Hot 30i / Tecno / XOS / HiOS)
+                intent.putExtra("slotIdx", slot)
+                intent.putExtra("com.transsion.telephony.slot", slot)
+                intent.putExtra("extra_slot_index", slot)
+
+                // Samsung One UI / Dual SIM
+                intent.putExtra("com.samsung.android.telephony.slot", slot)
+                intent.putExtra("com.samsung.android.telephony.simSlot", slot)
+
+                // Xiaomi / POCO / Redmi / MIUI / HyperOS
+                intent.putExtra("com.xiaomi.telephony.slot", slot)
+                intent.putExtra("sim_index", slot)
+
+                // Oppo / Realme / OnePlus ColorOS
+                intent.putExtra("com.oppo.telephony.slot", slot)
+                intent.putExtra("com.coloros.telephony.slot", slot)
+
+                // Vivo / iQOO Funtouch / OriginOS
+                intent.putExtra("com.vivo.telephony.slot", slot)
+
+                Log.d("UssdHelper", "buildCallIntent: routed to subId=$subId slot=$slot for code=$code")
+            } else {
+                Log.d("UssdHelper", "buildCallIntent: routed to subId=$subId (no slot info) for code=$code")
+            }
+
+            // Route via TelecomManager PhoneAccountHandle with strict matching
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                val handle = findPhoneAccountHandleForSubscription(context, subId, slot)
+                if (handle != null) {
+                    intent.putExtra(TelecomManager.EXTRA_PHONE_ACCOUNT_HANDLE, handle)
+                }
+            }
+        }
+        return intent
+    }
+
+    fun relaunchAppUi(
+        context: Context,
+        delayMs: Long = RETURN_TO_APP_DELAYS_MS.first(),
+        aggressiveRetries: Boolean = true
+    ) {
+        val appIntent = Intent(context, MainActivity::class.java).apply {
+            addFlags(
+                Intent.FLAG_ACTIVITY_NEW_TASK or
+                    Intent.FLAG_ACTIVITY_SINGLE_TOP or
+                    Intent.FLAG_ACTIVITY_CLEAR_TOP or
+                    Intent.FLAG_ACTIVITY_REORDER_TO_FRONT
+            )
+        }
+        val handler = Handler(Looper.getMainLooper())
+        val delays = if (aggressiveRetries) {
+            buildList {
+                add(delayMs.coerceAtLeast(0L))
+                RETURN_TO_APP_DELAYS_MS.forEach { scheduled ->
+                    if (scheduled > delayMs) add(scheduled)
+                }
+            }.distinct()
+        } else {
+            listOf(delayMs.coerceAtLeast(0L))
+        }
+        delays.forEach { scheduledDelay ->
+            val action = Runnable {
+                runCatching { context.startActivity(appIntent) }
+                    .onFailure { Log.w("UssdHelper", "Unable to relaunch app UI after USSD start", it) }
+            }
+            if (scheduledDelay <= 0L) {
+                handler.post(action)
+            } else {
+                handler.postDelayed(action, scheduledDelay)
+            }
+        }
+    }
+
+    private fun selectedTelephonyManager(context: Context, subIdOverride: Int? = null): TelephonyManager? {
+        val baseTm = context.getSystemService(Context.TELEPHONY_SERVICE) as? TelephonyManager ?: return null
+        val subId = subIdOverride ?: resolvePreferredUssdSubId(context)
+        if (subId != null && subId != -1 && Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
+            val subTm = runCatching { baseTm.createForSubscriptionId(subId) }.getOrNull()
+            if (subTm != null) return subTm
+        }
+        return baseTm
+    }
+}
