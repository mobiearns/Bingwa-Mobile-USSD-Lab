++    private fun getUssdRoot(): AccessibilityNodeInfo? {
++        val allowSystemWindows = advancedActive || balanceCallback != null || tokenPurchaseCallback != null || signatureLearningMode || isForegroundUiActive()
++        val primary = rootInActiveWindow
++        if (primary != null) {
++            val pkg = primary.packageName?.toString().orEmpty()
++            val isPotentialUssd = isPotentialUssdPackage(pkg) || pkg == "android"
++            val systemUiDialogAllowed = pkg == "com.android.systemui" && shouldAllowSystemUiDialogRoot(primary, pkg)
++            val allowBlocked = pkg !in BLOCKED_PACKAGES || systemUiDialogAllowed
++
++            if (allowBlocked && (isPotentialUssd || shouldAllowAndroidDialogRoot(primary, pkg) || systemUiDialogAllowed)) {
++                if (signatureLearningMode) {
++                    UssdPerformanceDiagnostics.recordLearningWindowFound(pkg, primary.windowId, isDialog = true)
++                }
++                return primary
++            }
++            primary.recycle()
++        }
++
++        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
++            val visibleWindows = try { windows } catch (_: Exception) { null }
++            if (visibleWindows.isNullOrEmpty()) return null
++            try {
++                // Filter out keyboards, overlays, and known non-target windows before querying window roots
++                val candidateWindows = visibleWindows.filter { window ->
++                    if (!allowSystemWindows) {
++                        if (window.type == AccessibilityWindowInfo.TYPE_SYSTEM ||
++                            window.type == AccessibilityWindowInfo.TYPE_ACCESSIBILITY_OVERLAY
++                        ) return@filter false
++                    }
++                    if (window.type == AccessibilityWindowInfo.TYPE_INPUT_METHOD ||
++                        window.type == AccessibilityWindowInfo.TYPE_SPLIT_SCREEN_DIVIDER ||
++                        window.type == AccessibilityWindowInfo.TYPE_ACCESSIBILITY_OVERLAY
++                    ) return@filter false
++
++                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
++                        val title = runCatching { window.title?.toString()?.lowercase() }.getOrNull().orEmpty()
++                        if (title.isNotBlank() && UssdNavigationConfig.SYSTEM_UI_NON_DIALOG_WINDOW_TITLES.any { title.contains(it) }) {
++                            return@filter false
++                        }
++                    }
++                    true
++                }.sortedWith(
++                    compareByDescending<AccessibilityWindowInfo> { runCatching { it.isActive }.getOrDefault(false) }
++                        .thenByDescending { runCatching { it.layer }.getOrDefault(0) }
++                )
++
++                // Pass 1: Prioritize genuine telephony and android framework windows
++                for (window in candidateWindows) {
++                    val root = try { window.root } catch (_: Exception) { null } ?: continue
++                    val pkg = root.packageName?.toString().orEmpty()
++                    if (pkg in BLOCKED_PACKAGES && pkg != "com.android.systemui") {
++                        root.recycle()
++                        continue
++                    }
++                    if (isPotentialUssdPackage(pkg) || pkg == "android" || shouldAllowAndroidDialogRoot(root, pkg)) {
++                        if (signatureLearningMode) {
++                            UssdPerformanceDiagnostics.recordLearningWindowFound(pkg, root.windowId, isDialog = true)
++                        }
++                        return root
++                    }
++                    root.recycle()
++                }
++
++                // Pass 2: Fall back to verified SystemUI dialogs only if no telephony window was found
++                if (allowSystemWindows) {
++                    for (window in candidateWindows) {
++                        val root = try { window.root } catch (_: Exception) { null } ?: continue
++                        val pkg = root.packageName?.toString().orEmpty()
++                        if (pkg == "com.android.systemui" && shouldAllowSystemUiDialogRoot(root, pkg)) {
++                            if (signatureLearningMode) {
++                                UssdPerformanceDiagnostics.recordLearningWindowFound(pkg, root.windowId, isDialog = true)
++                            }
++                            return root
++                        }
++                        root.recycle()
++                    }
++                }
++            } finally {
++                visibleWindows.forEach { window -> runCatching { window.recycle() } }
++            }
