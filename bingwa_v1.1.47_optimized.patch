++        when (val value = all[key]) {
++            is Long -> value
++            is Int -> value.toLong()
++            is Float -> value.toLong()
++            is Double -> value.toLong()
++            is String -> value.trim().toLongOrNull() ?: defaultValue
++            is Boolean -> if (value) 1L else 0L
++            else -> defaultValue
++        }
++    }
