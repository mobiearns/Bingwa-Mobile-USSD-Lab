++                windowId = pendingStepAdvanceWindowId,
++                windowPkg = root.packageName?.toString().orEmpty(),
++                root = root,
++                snapshot = snapshot,
++                dialogText = dialogText
++            )
++            val promptKey = normalizeMenuText(snapshot?.promptText.orEmpty())
