+internal object C {
+    var bg by mutableStateOf(Color(0xFF0C1017))
+    var surface by mutableStateOf(Color(0xFF19161D))
+    var card by mutableStateOf(Color(0xFF2B262A))
+    var cardHi by mutableStateOf(Color(0xFF343035))
