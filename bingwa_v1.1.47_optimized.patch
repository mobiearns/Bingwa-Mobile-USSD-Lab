+    private fun normalizePhoneComparable(value: String?): String {
+        val digits = value.orEmpty().replace(Regex("\\D+"), "")
+        if (digits.length < 9) return ""
+        return UssdHelper.normalizeRecipientForUssdInput(digits).replace(Regex("\\D+"), "")
+    }
