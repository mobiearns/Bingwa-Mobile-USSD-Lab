+            fallbackEnabled = prefs.safeGetBoolean(KEY_FALLBACK_ENABLED, false),
+            fallbackRuleMode = normalizeFallbackRule(
+                rawMode = prefs.safeGetString(KEY_FALLBACK_RULE_MODE, null),
+                legacyOfferNotFound = legacyOfferNotFound,
