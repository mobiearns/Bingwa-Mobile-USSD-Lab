++    @Test
++    fun signatureLearningLifecycleWorkflow() {
++        // 1. Text normalization test
++        val rawCarrierMenu = "1: Daily Bundles\n2: Weekly Bundles\n3: Monthly Bundles\n98: MORE"
++        val normalized = rawCarrierMenu.lowercase()
