++            return false
++        }
++        val pkg = root.packageName?.toString().orEmpty()
++        if (pkg == "com.android.systemui") {
++            return shouldAllowSystemUiDialogRoot(root, pkg)
++        }
++        val allowedPkg = pkg.isBlank() ||
++            pkg == "android" ||
++            isPotentialUssdPackage(pkg)
