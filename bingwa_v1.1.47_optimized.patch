++        verticalAlignment = Alignment.CenterVertically
++    ) {
++        repeat(3) { index ->
++            val anchor = when (index) {
++                0 -> 0.15f
++                1 -> 0.50f
++                else -> 0.85f
++            }
++            val alpha = 0.35f + ((1f - kotlin.math.abs(offset - anchor) / 0.35f).coerceIn(0f, 1f) * 0.65f)
++            Box(
++                modifier = Modifier
++                    .size(5.dp)
++                    .clip(CircleShape)
++                    .background(accent.copy(alpha = alpha))
++            )
++        }
++    }
