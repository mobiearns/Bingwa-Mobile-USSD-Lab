+    internal fun rememberInputWrite(value: String) {
+        lastInputWriteValue = normalizeInputValue(value)
+        lastInputWriteElapsed = SystemClock.elapsedRealtime()
+        lastInputWriteStepIndex = currentStep
+        inputWriteAttemptCount++
+    }
