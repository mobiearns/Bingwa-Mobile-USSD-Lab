++    TX_SOURCE_AUTOMATED -> C.green
++    TX_SOURCE_MANUAL -> C.purple
++    TX_SOURCE_SMS_COMMAND -> C.blue
++    TX_SOURCE_AIRTIME -> C.orange
++    else -> C.cyan
