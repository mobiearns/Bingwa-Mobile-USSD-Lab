++        try {
++            val candidate = matches.firstOrNull {
++                runCatching { (it.isEditable || isTextEntryNode(it)) && it.isVisibleToUser }.getOrDefault(false)
++            } ?: return null
++            return AccessibilityNodeInfo.obtain(candidate)
++        } finally {
++            matches.forEach { runCatching { it.recycle() } }
++        }
++    }
