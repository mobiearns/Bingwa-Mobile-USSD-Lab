++            Log.d(TAG, "Scheduling retry #$retryCount in ${delay}ms")
++            retryRunnable?.let { timeoutHandler.removeCallbacks(it) }
++            val runnable = Runnable {
++                retryRunnable = null
++                startBalanceCheck(context, selectionOverride, persistResult)
++            }
