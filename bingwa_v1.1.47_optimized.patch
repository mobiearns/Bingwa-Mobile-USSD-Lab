+diff --git a/ci/android-release.yml b/ci/android-release.yml
+new file mode 100644
+index 0000000..4eb8297
+--- /dev/null
++++ b/ci/android-release.yml
+@@ -0,0 +1,140 @@
++name: Android release APK
++
++on:
++  push:
++    branches: [main]
++  workflow_dispatch:
++
++permissions:
++  contents: write
++
++concurrency:
++  group: android-release-${{ github.ref }}
++  cancel-in-progress: true
++
++jobs:
++  build-and-release:
++    runs-on: ubuntu-latest
++    steps:
++      - name: Checkout source and release tags
++        uses: actions/checkout@v4
++        with:
++          fetch-depth: 0
++
++      - name: Set up JDK 17
++        uses: actions/setup-java@v4
++        with:
++          distribution: temurin
++          java-version: "17"
++
++      - name: Set up Gradle
++        uses: gradle/actions/setup-gradle@v4
++
++      - name: Automatically increment Android version
++        id: version
++        shell: bash
++        run: |
++          set -euo pipefail
++          # Always base the release on the newest main commit. Several rapid pushes
++          # can otherwise leave an older queued run trying to push a version bump over
++          # newer source commits.
++          git fetch origin main --tags --force
++          git checkout main
++          git reset --hard origin/main
++
++          LATEST_TAG="$(git tag --list 'v[0-9]*' --sort=-v:refname | head -n 1)"
++          if [[ -n "$LATEST_TAG" ]]; then
++            BASE_VERSION="${LATEST_TAG#v}"
++          else
++            BASE_VERSION="$(sed -n 's/.*versionName = "\([^"]*\)".*/\1/p' app/build.gradle.kts | head -n 1)"
++          fi
++
++          IFS='.' read -r MAJOR MINOR PATCH <<< "$BASE_VERSION"
++          if [[ -z "${MAJOR:-}" || -z "${MINOR:-}" || -z "${PATCH:-}" ]]; then
++            echo "Could not parse base version: $BASE_VERSION" >&2
++            exit 1
++          fi
++
++          NEXT_PATCH=$((PATCH + 1))
++          NEXT_VERSION="$MAJOR.$MINOR.$NEXT_PATCH"
++          CURRENT_CODE="$(sed -n 's/.*versionCode = \([0-9]*\).*/\1/p' app/build.gradle.kts | head -n 1)"
++          if [[ -z "$CURRENT_CODE" ]]; then
++            echo "Could not read Android versionCode" >&2
++            exit 1
++          fi
++          NEXT_CODE=$((CURRENT_CODE + 1))
++
++          sed -i -E "s/versionCode = [0-9]+/versionCode = $NEXT_CODE/" app/build.gradle.kts
++          sed -i -E "s/versionName = \"[^\"]+\"/versionName = \"$NEXT_VERSION\"/" app/build.gradle.kts
++
++          if git diff --quiet -- app/build.gradle.kts; then
++            echo "Version file did not change; refusing to publish a duplicate version." >&2
++            exit 1
++          fi
++
++          git config user.name "github-actions[bot]"
++          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
++          git add app/build.gradle.kts
++          git commit -m "chore: prepare Android release v$NEXT_VERSION"
++
++          # GitHub occasionally returns a transient HTTP 500 while accepting a
++          # push. Confirm whether the commit landed, then retry safely without
++          # creating duplicate version-bump commits.
++          PUSHED=false
++          for attempt in 1 2 3 4 5; do
++            git fetch origin main --force
++            if git merge-base --is-ancestor HEAD origin/main; then
++              PUSHED=true
++              echo "Version commit is already present on origin/main."
++              break
++            fi
++
++            if git push origin HEAD:main; then
++              PUSHED=true
++              break
++            fi
++
++            echo "Push attempt $attempt failed; checking remote state before retry."
++            git fetch origin main --force
++            if git merge-base --is-ancestor HEAD origin/main; then
++              PUSHED=true
++              break
++            fi
++
++            if [[ "$attempt" -lt 5 ]]; then
++              sleep $((attempt * 5))
++            fi
++          done
++
++          if [[ "$PUSHED" != true ]]; then
++            echo "Unable to push release version commit after 5 attempts." >&2
++            exit 1
++          fi
++
++          echo "version_name=$NEXT_VERSION" >> "$GITHUB_OUTPUT"
++          echo "version_code=$NEXT_CODE" >> "$GITHUB_OUTPUT"
++
++      - name: Build and verify Android release
++        run: |
++          chmod +x ./gradlew
++          ./gradlew --no-daemon testDebugUnitTest lintDebug assembleRelease
++
++      - name: Prepare APK and release metadata
++        id: release
++        shell: bash
++        run: |
++          VERSION_NAME="${{ steps.version.outputs.version_name }}"
++          APK="$(find app/build/outputs/apk/release -maxdepth 1 -type f -name '*.apk' -print -quit)"
++          test -n "$APK"
++          mkdir -p release
++          cp "$APK" "release/bingwa-mobile-v${VERSION_NAME}.apk"
++          echo "version_name=$VERSION_NAME" >> "$GITHUB_OUTPUT"
++
++      - name: Publish GitHub release
++        uses: softprops/action-gh-release@v2
++        with:
++          tag_name: v${{ steps.release.outputs.version_name }}
++          target_commitish: main
++          name: Bingwa Mobile v${{ steps.release.outputs.version_name }}
++          generate_release_notes: true
++          files: release/*.apk
