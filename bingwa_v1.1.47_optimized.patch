+diff --git a/app/src/test/java/com/bingwa/mobile/UssdResponsePatternManagerTest.kt b/app/src/test/java/com/bingwa/mobile/UssdResponsePatternManagerTest.kt
+new file mode 100644
+index 0000000..9a1845a
+--- /dev/null
++++ b/app/src/test/java/com/bingwa/mobile/UssdResponsePatternManagerTest.kt
+@@ -0,0 +1,32 @@
++package com.bingwa.mobile
++
++import org.junit.Assert.assertEquals
++import org.junit.Test
++
++class UssdResponsePatternManagerTest {
++    private val manager = UssdResponsePatternManager(null)
++
++    @Test
++    fun maintenanceIsNotMisclassifiedByGenericFailureWords() {
++        assertEquals("UnderMaintenance", manager.determineResponseStatus(
++            "Service is currently under maintenance. Please try again later."
++        ))
++        assertEquals("UnderMaintenance", manager.determineResponseStatus(
++            "The service is temporarily unavailable due to a technical problem."
++        ))
++    }
++
++    @Test
++    fun explicitTransactionFailureWinsOverMaintenanceWording() {
++        assertEquals("Failed", manager.determineResponseStatus(
++            "Insufficient balance. Service temporarily unavailable."
++        ))
++    }
++
++    @Test
++    fun ordinaryTechnicalErrorRemainsFailed() {
++        assertEquals("Failed", manager.determineResponseStatus(
++            "Connection error. Please try again."
++        ))
++    }
++}
+diff --git a/app/src/test/java/com/bingwa/mobile/UssdSignatureMatchPolicyTest.kt b/app/src/test/java/com/bingwa/mobile/UssdSignatureMatchPolicyTest.kt
+new file mode 100644
+index 0000000..b41666e
+--- /dev/null
++++ b/app/src/test/java/com/bingwa/mobile/UssdSignatureMatchPolicyTest.kt
+@@ -0,0 +1,47 @@
++package com.bingwa.mobile
++
++import org.junit.Assert.assertFalse
++import org.junit.Assert.assertTrue
++import org.junit.Test
++
++class UssdSignatureMatchPolicyTest {
++    @Test
++    fun sameNumericPositionDoesNotOverrideChangedLabel() {
++        assertFalse(UssdSignatureMatchPolicy.isExactLabelMatch("Daily Data Bundle", "Weekly Voice Bundle"))
++    }
++
++    @Test
++    fun exactLabelCanBeRecognizedAfterOptionMoves() {
++        assertTrue(UssdSignatureMatchPolicy.isExactLabelMatch(" Daily   Data Bundle ", "daily data bundle"))
++    }
++
++    @Test
++    fun punctuationAndFormattingDifferencesDoNotBreakExactMatch() {
++        assertTrue(UssdSignatureMatchPolicy.isExactLabelMatch("Daily-Data (1 GB)!", "daily data 1 gb"))
++    }
++
++    @Test
++    fun accentDifferencesDoNotBreakExactMatch() {
++        assertTrue(UssdSignatureMatchPolicy.isExactLabelMatch("Crédit airtime", "Credit airtime"))
++    }
++
++    @Test
++    fun differentBundleSizesNeverBecomeAnExactMatch() {
++        assertFalse(UssdSignatureMatchPolicy.isExactLabelMatch("Daily Data 1 GB", "Daily Data 2 GB"))
++    }
++
++    @Test
++    fun oneWordFuzzyMatchCannotAutoAdjust() {
++        assertFalse(UssdSignatureMatchPolicy.isSafeFuzzyAdjustment(1.0, 1, 1, 1, 1.0))
++    }
++
++    @Test
++    fun strongDistinctFuzzyMatchMayAutoAdjust() {
++        assertTrue(UssdSignatureMatchPolicy.isSafeFuzzyAdjustment(0.94, 2, 2, 2, 0.30))
++    }
++
++    @Test
++    fun ambiguousFuzzyMatchCannotAutoAdjust() {
++        assertFalse(UssdSignatureMatchPolicy.isSafeFuzzyAdjustment(0.96, 3, 3, 3, 0.10))
++    }
++}
