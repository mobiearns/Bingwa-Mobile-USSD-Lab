++    private fun captureSignatureStepIfNeeded(
++        stepIndex: Int,
++        rawStep: String,
++        menu: ParsedMenuSignature?,
++        snapshot: UssdTreeSnapshot,
++        dialogText: String,
++        interactionRoot: AccessibilityNodeInfo,
++        windowPkg: String
++    ) {
++        if (!signatureLearningMode) return
++        val isString = isPhoneOrStringStep(rawStep)
