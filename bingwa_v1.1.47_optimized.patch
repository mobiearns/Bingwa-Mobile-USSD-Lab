++    private fun dialUssdAttempt(
++        context: Context,
++        code: String,
++        silentOnly: Boolean,
++        targets: List<UssdSimTarget>,
++        attemptIndex: Int,
++        onSuccess: ((String) -> Unit)?,
++        onFailure: ((String) -> Unit)?
