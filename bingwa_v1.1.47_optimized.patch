+                        color = C.t2,
+                        fontSize = 11.sp,
+                        lineHeight = 17.sp
+                    )
+
+                    Row(
+                        Modifier.fillMaxWidth(),
+                        horizontalArrangement = Arrangement.spacedBy(10.dp)
+                    ) {
+                        FallbackRouteNode(
+                            title = "Primary",
+                            offer = primaryOffer,
+                            accent = C.cyan,
+                            modifier = Modifier.weight(1f)
+                        )
+                        FallbackRouteNode(
+                            title = if (fallbackOffers.size > 1) "First backup" else "Backup",
+                            offer = firstFallback,
+                            accent = C.amber,
+                            modifier = Modifier.weight(1f)
+                        )
+                    }
+                }
+            }
+
+            Row(
+                Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.spacedBy(10.dp)
+            ) {
+                FallbackSummaryTile(
+                    label = "Trigger",
+                    value = fallbackRuleSummary,
+                    accent = C.cyan,
+                    modifier = Modifier.weight(1f)
