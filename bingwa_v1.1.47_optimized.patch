++                        TokenManager(appContext).addTokens(tokensToAdd)
++                        notify(appContext, "Tokens Added", "$tokensToAdd tokens added using KSh $amount airtime")
++                    }
++                    callback(true, null)
++                } else {
++                    callback(false, purchaseFailureMessage(appContext, amount))
++                }
++            }
++
++            if (!armed) {
++                callback(false, "Another airtime purchase is already running. Wait for it to finish.")
++                return
++            }
