++            .putBoolean(KEY_FALLBACK_TRIGGER_OFFER_NOT_FOUND, ruleIncludesOfferNotFound(normalizedRule))
++            .putBoolean(KEY_FALLBACK_TRIGGER_DAILY_LIMIT, ruleIncludesAlreadyRecommended(normalizedRule))
