++    private fun collectTreeSnapshot(node: AccessibilityNodeInfo, accumulator: TreeScanAccumulator, depth: Int = 0) {
++        if (depth > 14) return
++        try {
++            val isInputNode = isTextEntryNode(node)
++            if (isInputNode) {
++                // Do not capture editable text/contentDescription: they may contain a
++                // phone number, PIN or amount. An EditText hint is prompt metadata and
++                // is especially important on OEM dialogs that render the prompt there.
++                accumulator.hasEditableField = true
++                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
++                    node.hintText?.toString()?.trim()?.takeIf { it.isNotBlank() }?.let {
++                        accumulator.textTokens += it
++                        accumulator.promptTokens += it
++                    }
++                }
++            } else {
++                val directText = node.text?.toString()?.trim()
++                if (!directText.isNullOrBlank()) {
++                    accumulator.textTokens += directText
++                    accumulator.promptTokens += directText
++                }
++                val contentDesc = node.contentDescription?.toString()?.trim()
++                if (!contentDesc.isNullOrBlank() && contentDesc != directText) {
++                    accumulator.textTokens += contentDesc
++                    accumulator.promptTokens += contentDesc
++                }
++                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
++                    val hint = node.hintText?.toString()?.trim()
++                    if (!hint.isNullOrBlank() && hint != directText && hint != contentDesc) {
++                        accumulator.textTokens += hint
++                        accumulator.promptTokens += hint
++                    }
++                }
++            }
++            if (!accumulator.hasSendButton && isSendActionNode(node)) accumulator.hasSendButton = true
++            if (!accumulator.hasDismissButton && isDismissActionNode(node)) accumulator.hasDismissButton = true
++            val count = minOf(node.childCount, 30)
++            for (i in 0 until count) {
++                val child = try { node.getChild(i) } catch (_: Exception) { null } ?: continue
++                try {
++                    collectTreeSnapshot(child, accumulator, depth + 1)
++                } finally {
++                    child.recycle()
++                }
++            }
++        } catch (_: Exception) {}
++    }
